# =========================================================================
# POLARIS HOTEL & SANCTUARY — ENVIRONMENT VARIABLES
# =========================================================================

# MongoDB Community Server Connection (Installed locally on your Hostinger VPS)
# Default local MongoDB connection (100% Free, zero cloud subscription needed)
MONGODB_URI=mongodb://127.0.0.1:27017/polaris_hotel
MONGODB_DB_NAME=polaris_hotel

# Web Server Port (Default: 3000)
PORT=3000

# Environment Mode
NODE_ENV=production
